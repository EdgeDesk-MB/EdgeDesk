{
  "mcpServers": {
    "linear": {
      "command": "node",
      "args": [
        "/usr/local/lib/node_modules/mcp-linear/dist/index.js"
      ],
      "env": {
        "LINEAR_API_KEY": ""
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.githubcopilot.com/mcp/",
        "--header",
        "Authorization:Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "posthog": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.posthog.com/sse",
        "--header",
        "Authorization:Bearer ${POSTHOG_PERSONAL_API_KEY}"
      ],
      "env": {
        "POSTHOG_PERSONAL_API_KEY": ""
      }
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "@vercel/mcp-server"
      ],
      "env": {
        "VERCEL_TOKEN": ""
      }
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key="
      ]
    },
    "tana-local": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "http://127.0.0.1:8262/mcp",
        "--header",
        "Authorization:Bearer "
      ]
    },
    "supercut": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.supercut.ai/mcp",
        "--header",
        "Authorization:Bearer "
      ]
    },
    "pencil": {
      "transport": "stdio",
      "command": "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
      "args": [
        "--app",
        "desktop"
      ],
      "env": {}
    }
  }
}
