{
  "manifest_version": 3,
  "name": "Edgeways Betslip Fill",
  "version": "1.0.0",
  "description": "Fills the exchange betslip from Edgeways with one click. Fill only - you always place the bet yourself.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://192.168.50.71:3000/*",
        "https://*.ts.net/*"
      ],
      "js": ["edgeways-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.betdaq.com/*"],
      "js": ["betdaq-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
