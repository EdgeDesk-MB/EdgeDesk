# API-Football (https://www.api-football.com) - free tier: 100 requests/day.
# Without a key the app uses demo fixtures and the built-in match simulator.
# Edgeways caches live scores ~60s and fixtures ~10 min (budget guard ~95/day).
API_FOOTBALL_KEY=

# The Racing API (https://www.theracingapi.com) - free tier: today/tomorrow racecards.
# Provider refreshes today cards ~3 min / tomorrow ~15 min; Edgeways caches racecards 15 min.
# Basic plan (£) adds /v1/results/today for automated Winner/Place settlement.
# Username + password from your dashboard (HTTP Basic auth).
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Betfair Exchange API - free delayed app key for development (developer.betfair.com).
# Delayed prices are ~1–3 minutes behind live (fine for pre-race matched betting).
# Live prices require a paid Application Key. Uses your Betfair account credentials.
# If your Betfair account has 2FA (Authenticator), set BETFAIR_TOTP_SECRET to the
# base32 secret from the authenticator setup QR (not the 6-digit codes).
# Restart the dev server after adding keys; use Settings → Data & API → Test connection.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_TOTP_SECRET=

# Betdaq Exchange API - requires partner/vendor access (not publicly available).
# Placeholder for when credentials are issued.
BETDAQ_API_KEY=
BETDAQ_API_SECRET=

# PostHog product analytics + error tracking (EDGE-35). Public project token
# (safe to expose - ships in browser JS). Use the EU host for EU projects.
# Without these, analytics/error capture is silently disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Hosted Postgres (Neon) — EDGE-47. Local Mac keeps SQLite when unset.
# Use the Neon pooled connection string. Never commit the real value.
DATABASE_URL=
# Hosted desk cutover. Needs DATABASE_URL. Set to neon on Vercel and on this
# Mac when localhost should share Live bets/offers. Clerk Development and
# Production issue different user ids for the same email; the app then follows
# the canonical localhost owner desk (DEFAULT_DESK_OWNER_USER_ID).
EDGEWAYS_DESK_BACKEND=
# Localhost sharing Neon must not take the global feed lease (its live=all
# cache can freeze a finished match and write that over Live). Vercel is the
# poller. Set to 1 only when you explicitly want this Mac to poll.
# EDGEWAYS_FEED_SYNC=

# Resend transactional email (EDGE-26). Domain edgeways.app verified 11 Aug
# (Ireland eu-west-1). Create an API key in the Resend dashboard.
RESEND_API_KEY=
# Friendly From name (not just the address — otherwise inboxes show "hello").
RESEND_FROM=Edgeways <hello@edgeways.app>
# Optional: get an email when someone joins the waitlist (comma-separated).
# Prefer a Gmail (or other non-Zoho) inbox: Zoho rejects same-domain Resend mail
# to sam@edgeways.app with 554 ContentRejected.
WAITLIST_NOTIFY_TO=
# Optional: in-app feedback / bug / idea notify (comma-separated).
# Falls back to WAITLIST_NOTIFY_TO. Same Zoho bounce rule as above.
FEEDBACK_NOTIFY_TO=
# Optional: new account / trial / paid-invoice owner pings (comma-separated).
# Falls back to FEEDBACK_NOTIFY_TO, then WAITLIST_NOTIFY_TO.
SIGNUP_NOTIFY_TO=
# Resend Audience segments for live contact sync (Broadcasts).
RESEND_SEGMENT_ALL_USERS=
RESEND_SEGMENT_FREE=
RESEND_SEGMENT_PAID=

# Offer inbox (email forwarding). Each desk gets offers+<token>@<domain>;
# the provider POSTs inbound mail to /api/offers/inbound.
# Domain with MX pointed at the inbound provider (catch-all).
EDGEWAYS_INBOUND_DOMAIN=in.edgeways.app
# Webhook signing secret (whsec_… from the provider). Production refuses
# inbound mail without it; local dev may leave it unset (signature skipped).
EDGEWAYS_INBOUND_WEBHOOK_SECRET=
# Note: Resend's email.received webhook carries metadata only - the body is
# fetched from the Receiving API using the RESEND_API_KEY above.

# Public site origin for emails and share tags. Apex only; never www
# (Google treats www as a different host). Not used for Stripe return URLs
# (those follow the host that started checkout, so local stays on localhost).
NEXT_PUBLIC_SITE_URL=https://edgeways.app

# Public root surface for this deploy: waitlist | app
# Production (Vercel, verified 4 Sep 2026): SITE_SURFACE=app
# EDGE-109: unset means waitlist (fail closed) — the desk only opens when
# this is explicitly "app". Leave waitlist here for local/new envs.
SITE_SURFACE=waitlist

# Homepage version: waitlist | launch
# Production is launch (verified 4 Sep 2026). Do not set waitlist on
# production. Local/new envs may stay waitlist.
LANDING_VARIANT=waitlist

# Clerk auth (EDGE-19/20). From Clerk Dashboard → API Keys.
# Never commit real values. Add the same pair to Vercel env (Production + Preview).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Public demo cookie HMAC (EDGE-91). Optional — falls back to CLERK_SECRET_KEY.
# Set a dedicated value to rotate demo access without touching Clerk.
PUBLIC_DEMO_COOKIE_SECRET=
# Custom paths (login framework; wire CTA from landing later).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/desk
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/desk

# Local only: Clerk email that keeps data/edgeways.db (the filled dogfood desk).
# Other signed-in users get an empty data/desks/{clerkUserId}.db for first-run.
# Full hosted tenancy is the rest of EDGE-47. Safe to omit on Vercel.
EDGEWAYS_DESK_OWNER_EMAIL=

# Extra operator emails for /admin (comma-separated). Bootstrap
# samhayter.design@gmail.com is always admin and cannot be demoted.
# Extra operators are not the owner: they get live toasts, not owner web push.
EDGEWAYS_ADMIN_EMAILS=
# Extra owner emails (comma-separated). Default owner is
# samhayter.design@gmail.com. Owners cannot be demoted, receive owner
# web push, and can change live alerts.
EDGEWAYS_OWNER_EMAILS=

# Vercel Cron: Authorization Bearer for /api/cron/admin-live (every minute).
# Set the same value in Vercel env. Localhost has no cron; toasts only.
CRON_SECRET=

# Optional PostHog personal API for /admin/releases flag toggles (EU project).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional. Same account, used if Clerk omits email on a request.
# Defaults to the localhost Clerk Development id so Live follows that desk.
# EDGEWAYS_DESK_OWNER_USER_ID=user_3IT7V2FQfFhC2ZNg9Q4FjAbDEgQ

# Stripe (EDGE-3 catalogue, EDGE-4 checkout, EDGE-5 webhooks).
# Local and Preview: test key + test price IDs below.
# Production: live key + live price IDs in docs/strategy/subscriptions.md.
# Prefer a restricted key (rk_test_… / rk_live_…) over sk_. Never commit real values.
# Local webhooks: `stripe listen --forward-to localhost:3000/api/billing/webhook`
# then paste the whsec_… into STRIPE_WEBHOOK_SECRET (do not commit it).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test Customer Portal (15 Aug 2026). Default on the account.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1U4fynCOWjjJHXGspM7CqwNq
STRIPE_PRICE_CORE_MONTH=price_1U4fVhCOWjjJHXGslhoF9ruI
STRIPE_PRICE_CORE_YEAR=price_1U4fViCOWjjJHXGs07dyqGvn
STRIPE_PRICE_EDGE_MONTH=price_1U4fVjCOWjjJHXGsM3Pj2Rr8
STRIPE_PRICE_EDGE_YEAR=price_1U4fVjCOWjjJHXGsotdJZ05Q
# Account term: 3 months of Edge at Core price. Not a public card.
STRIPE_PRICE_EDGE_FOUNDING_MONTH=price_1U4fVkCOWjjJHXGsXGvcKoqq
# EDGE-67 referrals: 50%-off-once coupon auto-applied at Checkout when the
# share-link claim is on the user (referred_by). Test coupon below. Production
# uses live coupon id `edge_referral_50_once`.
STRIPE_REFERRAL_COUPON_ID=dtyVuJTm
